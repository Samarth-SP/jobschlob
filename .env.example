# Neon pooled connection string (host with -pooler) — used by the app at runtime.
DATABASE_URL=

# Neon direct (non-pooled) connection string — used by drizzle-kit for migrations.
# Same value as DATABASE_URL locally is fine if you don't have a separate pooled/direct pair yet.
DIRECT_DATABASE_URL=

AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Comma-separated list of emails allowed to sign in.
ALLOWED_EMAILS=

# Powers the resume/cover-letter workshop and JD parsing by default (lib/resume-scaffold.ts,
# lib/jd-parse.ts) when a user hasn't configured their own key on the profile page — ingest's
# job-match scoring is local keyword matching, no LLM/API key needed.
ANTHROPIC_API_KEY=

# Only needed if a user routes a workshop step to OpenAI instead — there is no app-wide OpenAI
# default the way there is for Anthropic above (see lib/llm-client.ts).
OPENAI_API_KEY=

# 32 bytes, base64 — encrypts user-supplied API keys at rest in profiles.llm_config
# (lib/crypto.ts). Generate once with: openssl rand -base64 32
SETTINGS_ENCRYPTION_KEY=
