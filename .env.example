# Neon pooled connection string (host with -pooler) — used by the app at runtime.
DATABASE_URL=

# Neon direct (non-pooled) connection string — used by drizzle-kit for migrations.
# Same value as DATABASE_URL locally is fine if you don't have a separate pooled/direct pair yet.
DIRECT_DATABASE_URL=

AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Comma-separated list of emails allowed to sign in.
ALLOWED_EMAILS=

# Powers the resume/cover-letter workshop only (lib/resume-scaffold.ts) — ingest's job-match
# scoring is local keyword matching, no LLM/API key needed.
ANTHROPIC_API_KEY=
