# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# vercel
.vercel

# claude code local settings
.claude/settings.local.json

# typescript
*.tsbuildinfo
next-env.d.ts

# tectonic binary — platform-specific, downloaded fresh per build from GitHub releases (see
# scripts/setup-tectonic.js). .tectonic-cache is intentionally NOT ignored — it's plain TeX
# data/font files (portable, not compiled), and warming it fresh at build time depends on
# relay.fullyjustified.net (Tectonic's bundle CDN), which has 403'd Vercel's build machine before
# — a real production outage, not a hypothetical. Committing the warmed cache means a build never
# needs that CDN to be reachable at all. Re-run `node scripts/setup-tectonic.js` and commit the
# diff whenever scripts/fixture.tex's package list changes.
/bin
